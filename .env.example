APP_NAME=Gemma Tutor Edge
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DB_PATH=./data/gemma_tutor_edge.db
APP_STORAGE_DIR=./data/storage

# google | llama_cpp | test
LLM_BACKEND=google

# Hosted Gemini mode
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Local llama.cpp mode
# Inside docker compose, prefer http://llama:8080/v1
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=local-not-required
LLAMA_MODEL=gemma-4-e2b-it
LLAMA_VISION_ENABLED=true

# Optional frontend override for non-docker local dev.
VITE_API_BASE=http://127.0.0.1:8000

# Docker compose frontend settings.
# Leave WEB_VITE_API_BASE blank so the browser uses the tunnel/web origin and Vite proxies /v1 to the api container.
WEB_VITE_API_BASE=
VITE_DEV_PROXY_TARGET=http://api:8000

# Optional local model asset hint for scripts / docs
MODEL_DIR=~/models

# Optional telemetry
ENABLE_LOGFIRE=false
LOGFIRE_TOKEN=
