APP_NAME=Gemma Tutor Edge
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DB_PATH=/app/data/gemma_tutor_edge.db
APP_STORAGE_DIR=/app/data/storage

# google | llama_cpp | test
LLM_BACKEND=google

# Hosted Gemini path
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Local llama.cpp path
HOST_MODEL_DIR=/absolute/path/to/your/models
LLAMA_GGUF_PATH=/models/gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_MMPROJ_PATH=/models/mmproj-F16.gguf
LLAMA_BASE_URL=http://llama:8080/v1
LLAMA_API_KEY=local-not-required
LLAMA_MODEL=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_VISION_ENABLED=true
MODEL_DIR=/models
VALIDATE_LLAMA_ASSETS=false

# Frontend
# Leave blank in docker compose so the browser uses the same origin and Vite proxies /v1 to the api container.
WEB_VITE_API_BASE=
VITE_DEV_PROXY_TARGET=http://api:8000
